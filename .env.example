# =============================================================================
# .env.example — copy to .env for local development.
# All values are required unless marked optional.
# NEVER commit .env to version control.
# =============================================================================

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram after creating a new bot
TELEGRAM_BOT_TOKEN=

# Arbitrary secret string you choose; used to verify webhook requests in the
# Cloudflare Worker and when registering the webhook URL with Telegram
TELEGRAM_WEBHOOK_SECRET=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Sign up at https://openrouter.ai, create an API key, add credits
# The bot uses the anthropic/claude-sonnet-4-6 model through OpenRouter
OPENROUTER_API_KEY=

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# Free tier at https://newsapi.org — sign up and copy your API key
NEWSAPI_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# From your Supabase project → Settings → API
# URL format: https://<project-ref>.supabase.co
SUPABASE_URL=
# Use the "service_role" key (NOT the anon key) — it bypasses RLS
SUPABASE_SERVICE_KEY=

# ── GitHub Actions ────────────────────────────────────────────────────────────
# Personal Access Token with repo + workflow scopes
# Used by the Cloudflare Worker to trigger workflow_dispatch for /brief
GITHUB_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
